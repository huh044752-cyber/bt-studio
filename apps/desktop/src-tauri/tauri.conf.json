{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BT Studio",
  "version": "0.1.0",
  "identifier": "com.fosim.btstudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "pnpm --filter @btstudio/desktop dev",
    "beforeBuildCommand": "pnpm --filter @btstudio/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "BT Studio — 独立行为树设计平台",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
