{
  "name": "@btstudio/bt-core",
  "version": "0.1.0",
  "description": "BT Studio 核心引擎:设计态模型、Node Registry、Command Bus、Validation、MAL、Export/Import。纯 TS,无 DOM/Tauri 依赖。",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fast-xml-parser": "4.5.0"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
